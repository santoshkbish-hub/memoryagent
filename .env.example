DEEPSEEK_API_KEY=api key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_MEMORY_MODEL=deepseek-chat

# Optional. Defaults to ./memory_agent.sqlite3
MEMORY_DB_PATH=./memory_agent.sqlite3

# Embedding provider: "local" uses sentence-transformers (runs locally, no API needed).
# Set EMBEDDING_PROVIDER=openai_compatible to use a hosted embedding API instead.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Only needed for openai_compatible provider:
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
